# Sao chep file nay thanh .env roi dien gia tri that. File .env khong duoc dua len Git.

# Mat khau tai khoan sa. Neu chay SQL Server bang Docker, mat khau phai co it nhat 8 ky tu
# gom chu hoa, chu thuong, so va ky tu dac biet.
DB_PASSWORD=change-me
DB_USERNAME=sa

# Toi thieu 32 ky tu ngau nhien. Tao bang lenh: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Khong bat buoc
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=bookstore;encrypt=false
# REDIS_HOST=localhost
# REDIS_PORT=6379
# CORS_ALLOWED_ORIGINS=http://localhost:3000
